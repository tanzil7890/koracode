{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "0.0.0",
  "name": "@koracode/kcode-serve",
  "description": "Serve-only kcode binary variant for headless containers",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "bun run script/build.ts"
  },
  "dependencies": {
    "@koracode/kcode-browser": "workspace:*",
    "@koracode/koracode-core": "workspace:*",
    "@opencode-ai/core": "workspace:*",
    "@opencode-ai/script": "workspace:*",
    "yargs": "18.0.0"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/yargs": "17.0.33"
  }
}
