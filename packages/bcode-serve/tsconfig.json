{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "noUncheckedIndexedAccess": false,
    "customConditions": ["browser"],
    // opencode sources reach each other through `@/*`; tsc needs the same
    // mapping the bundler gets from packages/opencode/tsconfig.json.
    "paths": {
      "@/*": ["../opencode/src/*"]
    }
  },
  // opencode's ambient module declarations (`*.wasm`, `*.sql`, `*.md`) are
  // implicit inside that package; pull them in so typecheck here is honest.
  "include": ["src/**/*", "script/**/*", "../opencode/src/*.d.ts"]
}
